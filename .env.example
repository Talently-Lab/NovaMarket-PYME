# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# ─── Base de datos (Supabase / PostgreSQL) ───────────────────────────────────
# Obtener desde: Supabase → Settings → Database → Connection string → URI
# Reemplazar [YOUR-PASSWORD] por la contraseña real de la base de datos
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ─── Autenticación JWT (pendiente de implementar) ────────────────────────────
# Usar una cadena larga y aleatoria, nunca "secret" ni "123456"
JWT_SECRET=
